---
import { SEO } from "astro-seo";
import "../styles/global.css";

interface OpenGraph {
  title: string;
  type: string;
  image: string;
  url: string;
}

export interface HreflangAlternate {
  lang: string;
  url: string;
}

export interface Props {
  title: string;
  description: string;
  openGraph: OpenGraph;
  /** BCP 47 language of the page, rendered on <html lang>. Defaults to "en". */
  lang?: string;
  /** hreflang alternates for this page, including its own self-reference. */
  alternates?: HreflangAlternate[];
  /** JSON-LD schema.org objects to emit for this page. */
  schema?: object[];
}

const { title, description, openGraph, lang = "en", alternates, schema } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <SEO
      title={title}
      description={description}
      openGraph={{ basic: openGraph }}
      twitter={{
        creator: "@bepituLaz",
      }}
    />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#af2424" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {alternates?.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.url} />)}
    {schema?.map((obj) => (
      <script type="application/ld+json" set:html={JSON.stringify(obj)} />
    ))}

    <script
      defer
      data-domain="asepbagja.com"
      src="https://plausible.io/js/script.js"></script>

  </head>
  <body class="bg-cream dark:bg-slate-900 text-charcoal dark:text-neutral-200 font-inter">
    <slot />

    <script src="../../node_modules/preline/preline.js"></script>
  </body>
</html>
