---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import OneGridArticle from "../../components/OneGridArticle.astro";

const articles = await getCollection("blog", ({ id }) => {
  return id.startsWith("id/");
});

const sortedByLatestDate = articles.sort((a, b) => {
  return new Date(b.data.date).getTime() - new Date(a.data.date).getTime();
});

const populateCategories = (articles) => {
  const categories = articles.reduce((acc, article) => {
    const cats = article.data.categories.map((category) => category);
    return [...acc, ...cats];
  }, []);
  return [...new Set(categories)];
};

const categories = populateCategories(articles);

const articlesByCategory = categories.map((category: string) => {
  const catArticles = sortedByLatestDate.filter((article) => {
    return article.data.categories.includes(category);
  });
  return [category, catArticles];
});

const articlesMap = Object.fromEntries(articlesByCategory);
---

<Layout
  title="Blog | Asep Bagja"
  description="Tulisan saya pada topik-topik yang saya senangi"
  openGraph={{
    title: "Blog | Asep Bagja",
    url: "https://www.asepbagja.com/id/blog",
    image: "https://www.asepbagja.com/images/blog-id.png",
    type: "website",
  }}
>
  <Navbar />
  <section class="max-w-3xl px-4 mt-10 pt-10 lg:pt-14 sm:px-6 lg:px-8 mx-auto">
    <div class="mx-auto max-w-2xl mb-8 lg:mb-14 text-center">
      <h2 class="text-5xl lg:text-4xl text-gray-800 font-bold dark:text-neutral-200 font-manrope">Blog</h2>
      <p class="mt-3 text-xl text-gray-800 dark:text-neutral-200">
        Tulisan saya pada topik yang saya senangi
      </p>
    </div>
  </section>

  <div class="max-w-[85rem] px-4 sm:px-6 lg:px-8 mx-auto pb-24">
    {
      categories.map((category: string) => (
        <div class="mb-14">
          <div class="flex justify-between items-center mb-6 pb-2 border-b border-gray-200 dark:border-neutral-700">
            <h3 class="text-2xl font-bold font-manrope text-gray-800 dark:text-neutral-200">{category}</h3>
            {articlesMap[category].length > 4 && (
              <a
                href={`/id/${category.toLowerCase()}`}
                class="text-sm text-sage-600 hover:text-sage-800 dark:text-sage-400 dark:hover:text-sage-300 underline"
              >
                Lihat semua
              </a>
            )}
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {articlesMap[category].slice(0, 4).map((article) => (
              <OneGridArticle
                title={article.data.title}
                excerpt={article.data.summary}
                imageSrc={article.data.images?.[0]}
                imageAlt={`Gambar dari artikel ${article.data.title}`}
                href={`/id/${article.data.categories?.[0].toLowerCase()}/${article.slug.replace("id/", "")}`}
              />
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <Footer />
</Layout>
