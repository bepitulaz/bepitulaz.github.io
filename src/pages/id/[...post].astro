---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import AuthorImg from "../../assets/web/hero.jpg";

export async function getStaticPaths() {
  const articles = await getCollection("blog", ({ id }) => {
    return id.startsWith("id/");
  });

  return articles.map((article) => {
    const category = article.data.categories[0].toLowerCase();
    const slug = article.slug.replace("id/", "");

    return {
      params: {
        post: `${category}/${slug}`,
      },
      props: {
        article,
        slug: `${category}/${slug}`,
        image: article.data.images[0],
      },
    };
  });
}

const { article, slug, image } = Astro.props;
const { Content } = await article.render();

// Format date into DD MMMM YYYY from article.data.date
const date = new Date(article.data.date);
const formattedDate = date.toLocaleDateString();
const isIndonesian = Astro.url.pathname.startsWith("/id");
const language = isIndonesian ? "Bahasa Indonesia" : "English";

// Calculate reading time
const readingTime = Math.ceil(article.body.split(" ").length / 200);
---

<Layout
  title={`${article.data.title} | Asep Bagja`}
  description={article.data.summary}
  openGraph={{
    title: `${article.data.title} | Asep Bagja`,
    url: "https://www.asepbagja.com/id/" + slug,
    image: "https://www.asepbagja.com" + image,
    type: "website",
  }}
>
  <Navbar />

  <!-- Blog Article -->
  <div
    class="max-w-3xl px-4 mt-10 pt-10 lg:pt-10 pb-12 sm:px-6 lg:px-8 mx-auto"
  >
    <div class="max-w-2xl">
      <!-- Avatar Media -->
      <div class="flex justify-between items-center mb-6">
        <div class="flex w-full sm:items-center gap-x-5 sm:gap-x-3">
          <div class="shrink-0">
            <img
              class="size-12 rounded-full"
              src={AuthorImg.src}
              alt="Asep Bagja"
            />
          </div>

          <div class="grow">
            <div class="flex justify-between items-center gap-x-2">
              <div>
                <!-- Tooltip -->
                <div
                  class="hs-tooltip [--trigger:hover] [--placement:bottom] inline-block"
                >
                  <div class="sm:mb-1 block text-start">
                    <span
                      class="font-semibold text-gray-800 dark:text-neutral-200"
                    >
                      {language}
                    </span>
                  </div>
                </div>
                <!-- End Tooltip -->

                <ul class="text-md text-gray-500 dark:text-neutral-500">
                  <li
                    class="inline-block relative pe-6 last:pe-0 last-of-type:before:hidden before:absolute before:top-1/2 before:end-2 before:-translate-y-1/2 before:size-1 before:bg-gray-300 before:rounded-full dark:text-neutral-400 dark:before:bg-neutral-600"
                  >
                    {formattedDate}
                  </li>
                  <li
                    class="inline-block relative pe-6 last:pe-0 last-of-type:before:hidden before:absolute before:top-1/2 before:end-2 before:-translate-y-1/2 before:size-1 before:bg-gray-300 before:rounded-full dark:text-neutral-400 dark:before:bg-neutral-600"
                  >
                    {
                      isIndonesian
                        ? `${readingTime} menit baca`
                        : `${readingTime} min read`
                    }
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- End Avatar Media -->

      <!-- Content -->
      <div class="space-y-5 md:space-y-8">
        <div class="space-y-3">
          <h2 class="text-3xl font-bold md:text-3xl font-manrope text-gray-800 dark:text-white">
            {article.data.title}
          </h2>
        </div>

        <div class="blog text-xl text-gray-700 dark:text-neutral-300">
          <Content />
        </div>
        <div>
          {
            article.data.categories.map((category) => (
              <a
                class="m-1 inline-flex items-center gap-1.5 py-2 px-3 rounded-full text-sm bg-gray-100 text-gray-800 hover:bg-gray-200 focus:outline-none focus:bg-gray-200 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-700 dark:focus:bg-neutral-700"
                href="#"
              >
                {category}
              </a>
            ))
          }
        </div>
      </div>
      <!-- End Content -->
    </div>
  </div>
  <!-- End Blog Article -->
  <Footer />
</Layout>


<style is:inline>
  div.blog a {
    color: #356d67;
    text-decoration: underline;
    font-weight: 600;
  }

  div.blog a:hover {
    color: #26524d;
  }

  div.blog p {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  div.blog h2,
  div.blog h3,
  div.blog h4 {
    font-family: "Manrope", sans-serif;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: #2C2C2C;
  }

  div.blog h2 { font-size: 1.75rem; }
  div.blog h3 { font-size: 1.5rem; }
  div.blog h4 { font-size: 1.25rem; }

  div.blog ol,
  div.blog ul {
    margin-left: 2.5rem;
    font-size: 1.2rem;
    line-height: 2.25rem;
    list-style-type: disc;
  }

  div.blog ol {
    list-style-type: decimal;
  }

  div.blog .figure {
    text-align: center;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  div.blog .figure img,
  div.blog p img {
    width: 70%;
    display: block;
    margin: auto;
    border-radius: 0.75rem;
  }

  div.blog blockquote {
    background: rgba(70, 136, 128, 0.08);
    border-left: 4px solid #5d9e98;
    margin: 1.5em 0;
    padding: 0.75em 1.25em;
    border-radius: 0 0.5rem 0.5rem 0;
  }

  div.blog blockquote p {
    display: inline;
    font-size: 1.25rem;
    line-height: 2rem;
    color: #26524d;
  }

  div.blog blockquote cite {
    font-size: 1rem;
    color: #6b7280;
  }

  div.blog figcaption {
    font-size: 0.875rem;
    color: #6b7280;
    margin-top: 0.5rem;
    text-align: center;
  }

  @media (prefers-color-scheme: dark) {
    div.blog h2,
    div.blog h3,
    div.blog h4 {
      color: #e5e5e5;
    }

    div.blog blockquote {
      background: rgba(70, 136, 128, 0.12);
      border-left-color: #468880;
    }

    div.blog blockquote p {
      color: #7db5b0;
    }
  }

  @media (max-width: 767.98px) {
    div.blog .figure img,
    div.blog p img {
      width: 100%;
    }
  }
</style>
