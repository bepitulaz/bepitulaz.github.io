---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import EstoniaBackground from "../components/EstoniaBackground.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";

const links = [
    {
        title: "Hire Me",
        description: "What I build for clients and how a project starts",
        href: "/work",
        external: false,
    },
    {
        title: "nanas.build",
        description: "Custom parts, modelled with AI and 3D printed in Tallinn",
        href: "https://www.nanas.build",
        external: true,
    },
    {
        title: "Nanas Sound",
        description: "Music apps like AirBending and Bolabolabola, plus DIY hardware",
        href: "https://www.nanas.ee",
        external: true,
    },
    {
        title: "English Blog",
        description: "Writing about tech, music, and life",
        href: "/blog",
        external: false,
    },
    {
        title: "Blog Indonesia",
        description:
            "Artikel dalam Bahasa Indonesia tentang teknologi dan kehidupan di Estonia",
        href: "/id/blog",
        external: false,
    },
    {
        title: "About Me",
        description: "Self-taught, writing software since 2010",
        href: "/about",
        external: false,
    },
];
---

<Layout
    title="Home | Asep Bagja"
    description="Asep Bagja is a product and AI engineer in Tallinn, Estonia. He builds AI features, web apps, iOS apps, and firmware for clients, and runs Nanas Sound."
    openGraph={{
        title: "Home | Asep Bagja",
        url: "https://www.asepbagja.com",
        image: "https://www.asepbagja.com/images/paljassaare.jpg",
        type: "website",
    }}
>
    <EstoniaBackground />

    <div class="relative z-10" id="estonia-bg-hero-marker">
        <Hero />
    </div>

    <!-- Link Cards -->
    <div class="relative z-10">
        <div class="max-w-3xl mx-auto px-6 sm:px-8 pb-24">
            <div class="flex flex-col gap-4">
                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            {...(link.external
                                ? { target: "_blank", rel: "noopener" }
                                : {})}
                            class="glass-ice-card group flex items-center justify-between px-6 py-5 rounded-full"
                        >
                            <div>
                                <span class="font-manrope font-semibold text-charcoal dark:text-white text-lg">
                                    {link.title}
                                </span>
                                <p class="text-sm text-charcoal/50 dark:text-neutral-400 mt-0.5">
                                    {link.description}
                                </p>
                            </div>
                            <svg
                                class="shrink-0 size-5 text-sage-400 dark:text-sage-500 group-hover:text-sage-600 dark:group-hover:text-sage-300 group-hover:translate-x-1 transition-all duration-200"
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="m9 18 6-6-6-6" />
                            </svg>
                        </a>
                    ))
                }
            </div>
        </div>
    </div>

    <div class="relative z-10">
        <Footer />
    </div>
</Layout>
