---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import NordicBackground from "../components/NordicBackground.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";

const links = [
    {
        title: "Nanas Sound",
        description: "Musical tools & creative brand",
        href: "https://nanas.ee",
        external: true,
    },
    {
        title: "English Blog",
        description: "Writing about tech, music, and life",
        href: "https://asepbagja.substack.com",
        external: true,
    },
    {
        title: "Blog Indonesia",
        description: "Artikel dalam Bahasa Indonesia",
        href: "/id/blog",
        external: false,
    },
    {
        title: "DJ stream",
        description: "I stream DJ set for fun on Twitch",
        href: "https://www.twitch.tv/bepitulaz",
        external: true,
    },
    {
        title: "About Me",
        description: "Who is Asep Bagja?",
        href: "/about",
        external: false,
    },
];
---

<Layout
    title="Home | Asep Bagja"
    description="Asep Bagja — software engineer and electronic musician. Building musical tools and writing code."
    openGraph={{
        title: "Home | Asep Bagja",
        url: "https://www.asepbagja.com",
        image: "https://www.asepbagja.com/images/paljassaare.jpg",
        type: "website",
    }}
>
    <NordicBackground />

    <div class="relative z-10" id="nordic-bg-hero-marker">
        <Hero />
    </div>

    <!-- Link Cards -->
    <div class="relative z-10">
        <div class="max-w-3xl mx-auto px-6 sm:px-8 pb-24">
            <div class="flex flex-col gap-4">
                {
                    links.map((link) => (
                        <a
                            href={link.href}
                            {...(link.external
                                ? { target: "_blank", rel: "noopener" }
                                : {})}
                            class="glass-ice-card group flex items-center justify-between px-6 py-5 rounded-full"
                        >
                            <div>
                                <span class="font-manrope font-semibold text-charcoal dark:text-white text-lg">
                                    {link.title}
                                </span>
                                <p class="text-sm text-charcoal/50 dark:text-neutral-400 mt-0.5">
                                    {link.description}
                                </p>
                            </div>
                            <svg
                                class="shrink-0 size-5 text-sage-400 dark:text-sage-500 group-hover:text-sage-600 dark:group-hover:text-sage-300 group-hover:translate-x-1 transition-all duration-200"
                                xmlns="http://www.w3.org/2000/svg"
                                width="24"
                                height="24"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="m9 18 6-6-6-6" />
                            </svg>
                        </a>
                    ))
                }
            </div>
        </div>
    </div>

    <div class="relative z-10">
        <Footer />
    </div>
</Layout>
