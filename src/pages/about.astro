---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import AuthorImg from "../assets/web/hero.jpg";

const yearOfExperience = new Date().getFullYear() - 2010;
---

<Layout
    title="About Asep Bagja — Product & AI Engineer in Tallinn, Estonia"
    description="Who is Asep Bagja? Product & AI engineer in Tallinn, Estonia — self-taught, writing software since 2010, and building under Nanas Sound."
    openGraph={{
        title: "About Asep Bagja — Product & AI Engineer in Tallinn, Estonia",
        url: "https://www.asepbagja.com/about",
        image: "https://www.asepbagja.com/images/about.jpg",
        type: "website",
    }}
    schema={[
        {
            "@context": "https://schema.org",
            "@type": "ProfilePage",
            mainEntity: {
                "@type": "Person",
                name: "Asep Bagja",
                alternateName: "Asep Bagja Priandana",
                jobTitle: "Product & AI Engineer",
                url: "https://www.asepbagja.com/about/",
                image: "https://www.asepbagja.com/images/about.jpg",
                address: {
                    "@type": "PostalAddress",
                    addressLocality: "Tallinn",
                    addressCountry: "EE",
                },
                worksFor: {
                    "@type": "Organization",
                    name: "Chloe & Matt OÜ",
                    url: "https://chloematt.eu",
                },
                sameAs: [
                    "https://www.github.com/bepitulaz",
                    "https://www.linkedin.com/in/asepbagja/",
                    "https://www.x.com/bepitulaz",
                    "https://youtube.com/@bepitulaz",
                ],
            },
        },
        {
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            itemListElement: [
                { "@type": "ListItem", position: 1, name: "Home", item: "https://www.asepbagja.com/" },
                { "@type": "ListItem", position: 2, name: "About", item: "https://www.asepbagja.com/about/" },
            ],
        },
    ]}
>
    <Navbar />
    <!-- Profile -->
    <div
        class="max-w-3xl px-4 mt-10 pt-10 lg:pt-14 pb-12 sm:px-6 lg:px-8 mx-auto"
    >
        <!-- Title -->
        <div class="mx-auto max-w-2xl mb-8 lg:mb-14 text-center">
            <h2
                class="text-5xl lg:text-4xl text-gray-800 font-bold dark:text-neutral-200"
            >
                About
            </h2>
            <p class="mt-3 text-xl text-gray-800 dark:text-neutral-200">
                Get to know me
            </p>
        </div>

        <div class="flex items-center gap-x-3">
            <div class="shrink-0">
                <img
                    class="shrink-0 size-16 rounded-full"
                    src={AuthorImg.src}
                    alt="Asep Bagja"
                />
            </div>

            <div class="grow">
                <h1
                    class="text-lg font-medium text-gray-800 dark:text-neutral-200"
                >
                    Asep Bagja Priandana
                </h1>
                <p class="text-sm text-gray-600 dark:text-neutral-400">
                    {yearOfExperience} years of professional experience in software/web
                    development
                </p>
            </div>
        </div>
        <!-- End Profile -->

        <!-- About -->
        <div class="mt-8">
            <p class="text-xl text-gray-600 dark:text-neutral-400">
                I'm a self-taught software engineer and indie musician from
                Indonesia, now based in Tallinn, Estonia. My journey into the
                tech world started with a background in accounting, but my
                passion for building both software and hardware led me to carve
                out my own path in programming.
            </p>

            <p class="mt-3 text-xl text-gray-600 dark:text-neutral-400">
                I run two Estonian companies. At <b>Nanas Sound OÜ</b> (<a
                    class="underline underline-offset-4 hover:decoration-2"
                    href="https://www.nanas.ee"
                    target="_blank"
                    rel="noopener">nanas.ee</a
                > and <a
                    class="underline underline-offset-4 hover:decoration-2"
                    href="https://www.nanas.build"
                    target="_blank"
                    rel="noopener">nanas.build</a
                >) I build my own products: music apps for iOS and macOS, DIY
                hardware, and an AI-assisted CAD and 3D printing service.
                <b>Chloe & Matt OÜ</b> (<a
                    class="underline underline-offset-4 hover:decoration-2"
                    href="https://chloematt.eu"
                    target="_blank"
                    rel="noopener">chloematt.eu</a
                >) is the company I use for B2B software
                consulting and client invoicing. If you want to hire me, start
                with <a
                    class="underline underline-offset-4 hover:decoration-2"
                    href="/work">how I work with clients</a
                >.
            </p>

            <p class="mt-3 text-xl text-gray-600 dark:text-neutral-400">
                Music is my personal craft. I play piano and synthesizers and
                release electronic and ambient music as Asep Bagja and
                bepitulaz. Many of the product ideas behind Nanas Sound start
                there.
            </p>

            <p class="mt-3 text-xl text-gray-600 dark:text-neutral-400">
                Since beginning my career in 2010, I've had the opportunity to
                work with companies across Indonesia and Singapore, and even
                founded a few ventures of my own. Whether it's coding or
                composing, I love creating things that bring ideas to life.
            </p>

            <dl class="mt-8 flex flex-col gap-y-4">
                <div>
                    <dt class="text-sm text-gray-600 dark:text-neutral-400">
                        Consulting & freelance work
                    </dt>
                    <dd class="mt-0.5 flex items-center gap-x-2.5">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
                            <path d="M19.5 22.5a3 3 0 0 0 3-3v-8.174l-6.879 4.022 3.485 1.876a.75.75 0 1 1-.712 1.321l-5.683-3.06a1.5 1.5 0 0 0-1.422 0l-5.683 3.06a.75.75 0 0 1-.712-1.32l3.485-1.877L1.5 11.326V19.5a3 3 0 0 0 3 3h15Z"></path>
                            <path d="M1.5 9.589v-.745a3 3 0 0 1 1.578-2.642l7.5-4.038a3 3 0 0 1 2.844 0l7.5 4.038A3 3 0 0 1 22.5 8.844v.745l-8.426 4.926-.652-.351a3 3 0 0 0-2.844 0l-.652.351L1.5 9.589Z"></path>
                        </svg>
                        <a
                            class="text-md text-gray-700 underline hover:text-gray-900 hover:decoration-2 focus:outline-none focus:decoration-2 dark:text-neutral-300 dark:hover:text-white"
                            href="mailto:asep@chloeandmatt.eu?subject=Consulting%20enquiry"
                        >
                            asep@chloeandmatt.eu
                        </a>
                    </dd>
                </div>
                <div>
                    <dt class="text-sm text-gray-600 dark:text-neutral-400">
                        Nanas Sound & product enquiries
                    </dt>
                    <dd class="mt-0.5 flex items-center gap-x-2.5">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4" aria-hidden="true">
                            <path d="M19.5 22.5a3 3 0 0 0 3-3v-8.174l-6.879 4.022 3.485 1.876a.75.75 0 1 1-.712 1.321l-5.683-3.06a1.5 1.5 0 0 0-1.422 0l-5.683 3.06a.75.75 0 0 1-.712-1.32l3.485-1.877L1.5 11.326V19.5a3 3 0 0 0 3 3h15Z"></path>
                            <path d="M1.5 9.589v-.745a3 3 0 0 1 1.578-2.642l7.5-4.038a3 3 0 0 1 2.844 0l7.5 4.038A3 3 0 0 1 22.5 8.844v.745l-8.426 4.926-.652-.351a3 3 0 0 0-2.844 0l-.652.351L1.5 9.589Z"></path>
                        </svg>
                        <a
                            class="text-md text-gray-700 underline hover:text-gray-900 hover:decoration-2 focus:outline-none focus:decoration-2 dark:text-neutral-300 dark:hover:text-white"
                            href="mailto:asep@nanas.ee"
                        >
                            asep@nanas.ee
                        </a>
                    </dd>
                </div>
            </dl>
        </div>
    </div>
    <!-- End About -->
    <Footer />
</Layout>
