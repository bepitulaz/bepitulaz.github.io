---
import heroImg from "../assets/web/hero.jpg";
---

<div class="max-w-3xl mx-auto px-6 sm:px-8 py-16 sm:py-24">
    <!-- Two-column: photo + intro -->
    <div
        class="flex flex-col sm:flex-row items-center sm:items-start gap-8 sm:gap-12"
    >
        <div class="shrink-0">
            <img
                class="w-32 h-32 sm:w-40 sm:h-40 rounded-full object-cover ring-2 ring-sage-200 dark:ring-sage-700"
                src={heroImg.src}
                alt="Photo of Asep Bagja"
            />
        </div>
        <div class="text-center sm:text-left dark:[text-shadow:0_1px_3px_rgba(2,6,16,0.9),0_0_18px_rgba(2,6,16,0.8)]">
            <h1
                class="font-manrope font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tight text-charcoal dark:text-white leading-tight"
            >
                Asep Bagja
            </h1>
            <p
                class="mt-2 text-lg sm:text-xl text-charcoal/75 dark:text-neutral-200 font-manrope font-medium"
            >
                <span class="whitespace-nowrap">Principal Product & AI Engineer</span> · <span class="whitespace-nowrap">Founder of Nanas Sound</span>
            </p>
            <p class="mt-1 flex items-center justify-center sm:justify-start gap-1 text-sm text-charcoal/70 dark:text-neutral-300">
                <svg class="shrink-0 size-3.5" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
                </svg>
                Tallinn, Estonia · EU & Remote
            </p>
            <p
                class="mt-6 text-base sm:text-lg text-charcoal dark:text-neutral-100 leading-relaxed max-w-xl"
            >
                I help companies ship bounded AI integrations, full-stack web
                products, and hardware-software systems — without hiring a full
                team. Alongside client engineering, I build AI-assisted CAD tools at
                <a class="font-semibold underline decoration-sage-400 underline-offset-4 hover:decoration-2" href="https://www.nanas.build" target="_blank" rel="noopener">nanas.build</a>
                and musical instruments at
                <a class="font-semibold underline decoration-sage-400 underline-offset-4 hover:decoration-2" href="https://www.nanas.ee" target="_blank" rel="noopener">Nanas Sound</a>.
            </p>
            <p
                class="mt-4 text-base sm:text-lg text-charcoal dark:text-neutral-100 leading-relaxed max-w-xl"
            >
                Off the clock, I compose electronic music under the alias <b>bepitulaz</b>.
            </p>
            <div class="mt-8 flex flex-wrap items-center justify-center sm:justify-start gap-3 [text-shadow:none]">
                <a
                    href="/work"
                    class="inline-flex items-center gap-2 rounded-full bg-sage-600 px-5 py-3 font-manrope font-semibold text-white hover:bg-sage-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-sage-400 focus-visible:ring-offset-2 focus-visible:ring-offset-cream dark:bg-sage-300 dark:text-sage-900 dark:hover:bg-sage-200 dark:focus-visible:ring-offset-slate-900 transition-colors"
                >
                    Work with me
                    <svg class="shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </a>
                <a
                    href="mailto:asep@chloeandmatt.eu?subject=Consulting%20enquiry"
                    class="glass-ice inline-flex items-center rounded-full px-5 py-3 text-sm font-medium text-charcoal hover:text-sage-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-sage-400 dark:text-neutral-100 dark:hover:text-sage-200 transition-colors"
                >
                    Email asep@chloeandmatt.eu
                </a>
            </div>
        </div>
    </div>
</div>
