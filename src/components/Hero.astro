---
import heroImg from "../assets/web/hero.jpg";
---

<div class="max-w-3xl mx-auto px-6 sm:px-8 py-16 sm:py-24">
    <!-- Two-column: photo + intro -->
    <div
        class="flex flex-col sm:flex-row items-center sm:items-start gap-8 sm:gap-12"
    >
        <div class="shrink-0">
            <img
                class="w-32 h-32 sm:w-40 sm:h-40 rounded-full object-cover ring-2 ring-sage-200 dark:ring-sage-700"
                src={heroImg.src}
                alt="Photo of Asep Bagja"
            />
        </div>
        <div class="text-center sm:text-left">
            <h1
                class="font-manrope font-bold text-3xl sm:text-4xl lg:text-5xl tracking-tight text-charcoal dark:text-white leading-tight"
            >
                Asep Bagja
            </h1>
            <p
                class="mt-2 text-lg sm:text-xl text-charcoal/60 dark:text-neutral-400 font-manrope font-medium"
            >
                Software Engineer & Musician
            </p>
            <p class="mt-1 flex items-center justify-center sm:justify-start gap-1 text-sm text-charcoal/50 dark:text-neutral-500">
                <svg class="shrink-0 size-3.5" xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
                </svg>
                Tallinn, Estonia
            </p>
            <p
                class="mt-6 text-base sm:text-lg text-charcoal/80 dark:text-neutral-300 leading-relaxed max-w-xl"
            >
                I develop software for clients and design musical tools under
                <b>Nanas Sound</b>, working where systematic thinking meets
                creative expression.
            </p>
        </div>
    </div>
</div>
