---
export interface Props {
  title: string;
  excerpt: string;
  href: string;
  imageSrc: string;
  imageAlt: string;
}

const { title, excerpt, href, imageSrc, imageAlt } = Astro.props;
---
<article class="group block">
  <div class="aspect-video overflow-hidden rounded-xl">
    <img class="w-full h-full object-cover rounded-xl group-hover:scale-105 transition-transform duration-300" src={imageSrc} alt={imageAlt} />
  </div>
  <div class="pt-3">
    <a href={href} title={title}>
      <h4 class="font-manrope font-semibold text-lg text-gray-800 group-hover:text-sage-600 dark:text-neutral-200 dark:group-hover:text-white transition-colors">{title}</h4>
    </a>
    <p class="mt-1 text-gray-600 dark:text-neutral-400">{excerpt}</p>
  </div>
</article>
